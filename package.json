{
  "name": "aqtau-safe-mvp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node scripts/check-docker.mjs && node scripts/prepare-env.mjs",
    "dev": "docker compose up --build",
    "dev:next": "node scripts/copy-maplibre-worker.mjs && next dev --hostname 0.0.0.0",
    "dev:down": "docker compose down",
    "build": "node scripts/copy-maplibre-worker.mjs && prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "demo:air": "tsx scripts/demo-air-spike.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/workflow.test.ts tests/worker-queue.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:ui": "node tests/browser-ui-audit.mjs",
    "test:workflow": "node tests/browser-workflow.mjs",
    "test:camera": "node tests/browser-camera.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "2.4.3",
    "jose": "5.10.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "6.11.1",
    "next": "15.5.26",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.26",
    "playwright": "^1.58.2",
    "postcss": "8.5.28",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "postcss": "8.5.28",
    "effect": "3.22.2",
    "sharp": "0.35.4",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
