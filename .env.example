# ---- Database ----
POSTGRES_DB=aqtau_safe
POSTGRES_USER=aqtau
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aqtau:change_this_password@localhost:5432/aqtau_safe?schema=public

# ---- App / session ----
# Local dev: http://localhost:3000. Production: your https:// domain (needed for phone camera).
APP_PUBLIC_URL=http://localhost:3000
APP_PORT=3000
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
DEMO_PASSWORD=replace_with_a_demo_password
# Demo mode enables one-click role login and the 20s operator claim timeout.
# Set to false for a locked-down production deployment.
DEMO_MODE=true

# ---- Routing (real road routing; no LLM) ----
ROUTING_URL=https://router.project-osrm.org

# ---- Phone camera / WebRTC ----
# STUN works on the same LAN. For different networks configure a TURN server.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ---- CV service (separate FastAPI + MediaPipe) ----
CV_SERVICE_URL=http://cv:8000
CV_SERVICE_KEY=replace_with_a_shared_service_key
POSE_MODEL_PATH=/models/pose_landmarker_lite.task
DEMO_FALL_TIMEOUT=8
FALL_TIMEOUT=240
# Experimental temporal fight heuristic. Keep false unless you accept false positives.
ENABLE_FIGHT=false

# ---- Email invites for demo camera (optional) ----
# Without SMTP_URL, invitations are delivered to the resident's in-app notifications.
SMTP_URL=
SMTP_FROM=

# Антифрод: второе мнение Google Gemini (ключ из Google AI Studio). Без ключа работают только правила.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Production HTTPS (docker-compose.prod.yml + Caddy) ----
DOMAIN=aqtau.example.kz
